{
  "name": "freelancer-escrow-mvp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:system": "node scripts/check-system.mjs",
    "db:check": "node server/database-cli.mjs check",
    "db:select": "node server/select-database.mjs",
    "db:recover": "node server/recover-data.mjs",
    "db:cleanup": "node server/cleanup-data.mjs",
    "admin:check": "node server/check-admin.mjs",
    "mail:check": "node server/check-mail.mjs",
    "mail:test": "node server/test-mail.mjs",
    "db:migrate": "node server/database-cli.mjs migrate",
    "db:import:sqlite-accounts": "node server/import-sqlite-accounts.mjs",
    "test": "node --test tests/api.test.mjs tests/mail.test.mjs tests/persistence.test.mjs tests/hardhat-persistence.test.mjs tests/admin.test.mjs tests/admin-fesc.test.mjs",
    "test:e2e": "playwright test",
    "chain:node": "node scripts/local-node.mjs",
    "chain:init": "node scripts/init-local-chain.mjs",
    "chain:migrate": "node scripts/migrate-chain.mjs",
    "chain:adopt": "node scripts/adopt-chain.mjs",
    "chain:deploy": "hardhat run scripts/deploy-local.ts --network localhost",
    "chain:deploy:fesc": "hardhat run scripts/deploy-fesc-local.ts --network localhost",
    "chain:deploy:vault": "hardhat run scripts/deploy-vault-local.ts --network localhost",
    "compile:contracts": "hardhat compile",
    "test:contracts": "hardhat test nodejs",
    "typecheck:contracts": "tsc --project tsconfig.hardhat.json"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "mongodb": "7.8.0",
    "nodemailer": "10.6.0",
    "pg": "8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@openzeppelin/contracts": "5.6.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "hardhat": "3.21.2",
    "solc": "0.8.30",
    "typescript": "^5.7.2",
    "viem": "2.57.16",
    "vite": "^6.0.5",
    "zod": "4.6.7"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    },
    "zod": "$zod"
  },
  "optionalDependencies": {
    "@foundry-rs/anvil-darwin-amd64": "1.7.1",
    "@foundry-rs/anvil-darwin-arm64": "1.7.1",
    "@foundry-rs/anvil-linux-amd64": "1.7.1",
    "@foundry-rs/anvil-linux-arm64": "1.7.1",
    "@foundry-rs/anvil-win32-amd64": "1.7.1"
  }
}
